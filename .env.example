# ==============================================================================
# YOLO Editor — Canlı Ortam Yapılandırması (.env)
# Bu dosyayı canlı sunucunuzda '.env' olarak adlandırıp değerleri doldurunuz.
# ==============================================================================

# ── 1. Sunucu ve Ağ Ayarları ──
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS="*"

# ── 2. Güvenlik ve JWT Anahtarı ──
# Rastgele 64 karakterli güvenli bir anahtar belirleyin (Örn: openssl rand -hex 32)
JWT_SECRET_KEY=yolo-secret-key-change-this-in-production-2026-secure-random

# ── 3. E-Posta (SMTP / Gmail) Bildirim Ayarları ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ornek_hesap@gmail.com
SMTP_PASSWORD=uygulama_sifresi_16_karakter
SMTP_FROM="YOLO Platformu <ornek_hesap@gmail.com>"

# ── 4. Cloudflare D1 (Veritabanı) & R2 (Görsel Depolama) [Opsiyonel/Önerilen] ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=

# ── 5. Google OAuth 2.0 (Tek Tıkla Giriş) [Opsiyonel] ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://etiketleme.sirketiniz.com/api/auth/google/callback
